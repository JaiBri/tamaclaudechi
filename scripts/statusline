#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────
# Claude Code Status Line → Tamaclaudchi Context Monitor
#
# This script is invoked by Claude Code's statusLine feature.
# It receives JSON on stdin after every assistant message, extracts
# context window metrics, persists them to disk for the menu bar
# companion, and outputs a one-line status for the terminal.
#
# Install: add to ~/.claude/settings.json (user-level):
#   "statusLine": { "type": "command", "command": "/path/to/mascot/scripts/statusline" }
# ──────────────────────────────────────────────────────────────
set -uo pipefail

CONTEXT_DIR="${HOME}/.config/claude-mascot"

# Read JSON from stdin
INPUT=$(cat)

# Extract fields with one perl invocation (matching tamagotchi script pattern — no jq dependency)
eval "$(printf '%s' "$INPUT" | perl -e '
  local $/; my $j = <STDIN>;
  my ($r) = $j =~ /"remaining_percentage"\s*:\s*(-?[0-9.]+)/;
  my ($u) = $j =~ /"used_percentage"\s*:\s*(-?[0-9.]+)/;
  my ($s) = $j =~ /"session_id"\s*:\s*"([^"]*)"/;
  printf "remaining=%s\nused=%s\nsession_id=%s\n",
    ($r // ""), ($u // ""), ($s // "");
')"

# If we couldn't extract any context data at all (no context_window in input), pass through silently.
# Note: remaining/used being empty just means null JSON values (start of session) — that is valid.
if [ -z "$remaining" ] && [ -z "$used" ] && ! echo "$INPUT" | grep -q '"context_window"'; then
  exit 0
fi

# Default missing values
# remaining_percentage is null before the first assistant message — default to 100 (full context)
# used_percentage is null before the first assistant message — default to 0
remaining=${remaining:-100}
used=${used:-0}

# Round to integers (perl may give floats)
remaining=$(printf '%.0f' "$remaining")
used=$(printf '%.0f' "$used")

# Ensure directory exists (used by toast cooldown, baseline cleanup, scraper trigger)
mkdir -p "$CONTEXT_DIR"

# ANSI color codes (ANSI-C quoting so escapes are real bytes)
ESC=$'\033'
GREEN="${ESC}[32m"
RED="${ESC}[31m"
DARK_RED="${ESC}[38;5;88m"
ORANGE="${ESC}[38;5;208m"
YELLOW="${ESC}[33m"
MAGENTA="${ESC}[35m"
BOLD="${ESC}[1m"
DIM="${ESC}[2m"
RESET="${ESC}[0m"

# ── Helpers ──────────────────────────────────────────────────

# Compact large numbers: 15000→15k, 1200→1.2k, 800→800
compact_num() {
  local n=$1
  if [ "$n" -ge 10000 ]; then
    echo "$((n / 1000))k"
  elif [ "$n" -ge 1000 ]; then
    # One decimal place: 1200→1.2k
    local whole=$((n / 1000))
    local frac=$(( (n % 1000) / 100 ))
    if [ "$frac" -eq 0 ]; then
      echo "${whole}k"
    else
      echo "${whole}.${frac}k"
    fi
  else
    echo "$n"
  fi
}

# ── Source section files ─────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "${SCRIPT_DIR}/statusline-sections/git.sh"
source "${SCRIPT_DIR}/statusline-sections/usage.sh"
source "${SCRIPT_DIR}/statusline-sections/system.sh"
source "${SCRIPT_DIR}/statusline-sections/session-files.sh"

# Run git section
git=""
_git_branch="" _git_ahead=0 _git_behind=0 _git_staged=0 _git_unstaged=0
_git_untracked=0 _git_conflicts=0 _git_stash=0 _git_diff_add=0 _git_diff_del=0
_git_branches=0 _git_unmerged=0 _git_operation="" _git_worktree_count=0 _git_worktree_name=""
git_section

# Run usage section
usage=""
_usage_session_pct="" _usage_session_elapsed="" _usage_session_resets=""
_usage_week_pct="" _usage_week_elapsed="" _usage_week_resets=""
_usage_extra_spent="" _usage_extra_budget="" _usage_scraped_at=""
usage_section

# Run system section
system=""
_system_cpu=0 _system_ram=0 _system_disk=0 _system_swap=0 _system_swap_pct=0 _system_gpu="null"
_system_alerts="" _system_top_cpu="" _system_top_ram=""
system_section

# Run session files section
session_files=""
_session_files_count=0
_session_files_names=""
session_files_section

# Sidecar context.json removed: nothing reads its content. Frontend chat module reads
# cli-sessions.json via webhookService; the menu bar reads usage.json directly.

# OSC 8 hyperlink wrappers
LINK_ON="${ESC}]8;;"    # followed by URL then LINK_SEP
LINK_SEP="${ESC}\\"     # ends the URL, label text follows
LINK_OFF="${ESC}]8;;${ESC}\\"  # closes the hyperlink

# Service status (vite + cloudflared) — cached for 5s to keep render fast.
# session_id-keyed per docs: PID would change every invocation and defeat the cache.
SVC_CACHE="/tmp/statusline-services-${session_id:-default}"
SVC_TTL=5
svc_age=$(( $(date +%s) - $(stat -f %m "$SVC_CACHE" 2>/dev/null || echo 0) ))

if [ "$svc_age" -lt "$SVC_TTL" ] && [ -f "$SVC_CACHE" ]; then
  . "$SVC_CACHE"
else
  VITE_UP=0; CF_UP=0
  lsof -i :5173 -sTCP:LISTEN >/dev/null 2>&1 && VITE_UP=1
  pgrep -qf "cloudflared tunnel" >/dev/null 2>&1 && CF_UP=1
  TUNNEL_URL=""
  [ -f "${SVC_CACHE}.url" ] && TUNNEL_URL=$(cat "${SVC_CACHE}.url")
  printf 'VITE_UP=%s\nCF_UP=%s\nTUNNEL_URL=%s\n' \
    "$VITE_UP" "$CF_UP" "$TUNNEL_URL" > "$SVC_CACHE"
fi

# Refresh tunnel hostname out-of-band (was the worst offender: a synchronous curl on the render path).
url_age=$(( $(date +%s) - $(stat -f %m "${SVC_CACHE}.url" 2>/dev/null || echo 0) ))
if [ "${CF_UP:-0}" = "1" ] && [ "$url_age" -gt 30 ]; then
  (
    port=$(lsof -i -sTCP:LISTEN -P 2>/dev/null \
      | awk '/cloudflared/{ match($0,/:[0-9]+/); print substr($0,RSTART+1,RLENGTH-1); exit }')
    [ -n "$port" ] && curl -sm 1 "http://127.0.0.1:${port}/quicktunnel" 2>/dev/null \
      | perl -ne 'print $1 if /"hostname"\s*:\s*"([^"]*)"/' \
      > "${SVC_CACHE}.url.tmp" && mv -f "${SVC_CACHE}.url.tmp" "${SVC_CACHE}.url"
  ) & disown
fi

# Render dev indicator
if [ "${VITE_UP:-0}" = "1" ]; then
  vite="${LINK_ON}http://localhost:5173${LINK_SEP}${GREEN}● dev${RESET}${LINK_OFF}"
else
  vite="${RED}○${DIM} dev${RESET}"
fi

# Render tunnel indicator
if [ "${CF_UP:-0}" = "1" ]; then
  if [ -n "${TUNNEL_URL:-}" ]; then
    cf="${LINK_ON}https://${TUNNEL_URL}${LINK_SEP}${GREEN}● tunnel${RESET}${LINK_OFF}"
  else
    cf="${GREEN}● tunnel${RESET}"
  fi
else
  cf="${RED}○${DIM} tunnel${RESET}"
fi

# Render mempalace memory-save indicator. Sentinel file ~/.mempalace/disabled
# toggles the Stop-hook save behaviour. Off-state is loud (red) so it's obvious
# that auto-checkpointing is paused; on-state matches dev/tunnel green-dot style.
if [ -f "$HOME/.mempalace/disabled" ]; then
  mem="${RED}○${DIM} mem${RESET}"
else
  mem="${GREEN}● mem${RESET}"
fi

# Output status line for Claude Code's terminal
# Color thresholds: 90-80% remaining → orange, <80% → red, <70% → dark red
if [ "$remaining" -lt 70 ]; then
  brain="${DARK_RED}🧠 ${remaining}%${RESET}"
elif [ "$remaining" -lt 80 ]; then
  brain="${RED}🧠 ${remaining}%${RESET}"
elif [ "$remaining" -lt 90 ]; then
  brain="${ORANGE}🧠 ${remaining}%${RESET}"
else
  brain="🧠 ${remaining}%"
fi

# ── Single-line output ───────────────────────────────────────
join_and_emit() {
  local line="" s=""
  for part in "$@"; do
    line="${line}${s}${part}"
    s="  │  "
  done
  [ -n "$line" ] && echo "$line"
}

# Single line: context, services, git, system health
all_parts=("${brain}")
[ -n "$usage" ] && all_parts+=("${usage}")
all_parts+=("${vite}" "${cf}" "${mem}")
[ -n "$git" ] && all_parts+=("${git}")
[ -n "$system" ] && all_parts+=("${system}")

join_and_emit "${all_parts[@]}"

# ── Background usage scraper trigger ─────────────────────────
# Spawn scraper if cache is stale (>5 min) or missing
usage_file="${CONTEXT_DIR}/usage.json"
if [ ! -f "$usage_file" ] || [ $(( $(date +%s) - $(stat -f %m "$usage_file" 2>/dev/null || echo 0) )) -gt 300 ]; then
  scraper="${SCRIPT_DIR}/usage-scraper"
  if [ -x "$scraper" ]; then
    "$scraper" >/dev/null 2>&1 &
    disown
  fi
fi

# ── System alert toast trigger ────────────────────────────────
# Fire toast when new alerts appear (with 5-min cooldown per alert)
if [ -n "$_system_alerts" ]; then
  _last_alert_file="${CONTEXT_DIR}/.system-last-alert"
  _prev_alerts=""
  _prev_ts=0
  if [ -f "$_last_alert_file" ]; then
    _prev_alerts=$(head -1 "$_last_alert_file" 2>/dev/null || true)
    _prev_ts=$(tail -1 "$_last_alert_file" 2>/dev/null || echo 0)
  fi

  _now_ts=$(date +%s)
  _cooldown_elapsed=$(( _now_ts - _prev_ts ))
  _new_alerts=""

  # Find alerts not in previous set
  IFS="," read -ra _cur_arr <<< "$_system_alerts"
  for _ca in "${_cur_arr[@]}"; do
    if ! echo ",$_prev_alerts," | grep -q ",$_ca,"; then
      _new_alerts="${_new_alerts:+${_new_alerts},}${_ca}"
    fi
  done

  # Fire toast if new alerts appeared and cooldown (1800s / 30min) has elapsed
  if [ -n "$_new_alerts" ] && [ "$_cooldown_elapsed" -gt 1800 ]; then
    # Read mood from state.json
    _toast_mood="NEUTRAL"
    if [ -f "${CONTEXT_DIR}/state.json" ]; then
      _toast_mood=$(perl -ne 'print $1 if /"currentMood"\s*:\s*"([^"]*)"/' "${CONTEXT_DIR}/state.json" 2>/dev/null || echo "NEUTRAL")
    fi
    [ -z "$_toast_mood" ] && _toast_mood="NEUTRAL"

    # Build short alert message
    _toast_msg=""
    for _ca in "${_cur_arr[@]}"; do
      case "$_ca" in
        cpu)  _toast_msg="${_toast_msg}CPU ${_system_cpu}% " ;;
        ram)  _toast_msg="${_toast_msg}RAM ${_system_ram}% " ;;
        swap) _toast_msg="${_toast_msg}Swap ${_system_swap_pct}% " ;;
        disk) _toast_msg="${_toast_msg}Disk ${_system_disk}% " ;;
        gpu)  _toast_msg="${_toast_msg}GPU ${_system_gpu}% " ;;
      esac
    done
    _toast_msg="${_toast_msg}— ${_system_top_cpu:-something} is hungry"

    # Dynamic duration: ~15 chars/sec reading speed, clamped 4–10s
    _toast_len=${#_toast_msg}
    _toast_dur=$(( _toast_len / 15 ))
    [ "$_toast_dur" -lt 4 ] && _toast_dur=4
    [ "$_toast_dur" -gt 10 ] && _toast_dur=10

    _toast_script="${SCRIPT_DIR}/toast"
    if [ -x "$_toast_script" ]; then
      "$_toast_script" --mode done --mood "$_toast_mood" "$_toast_msg" "$_toast_dur" &
      disown
    fi

    # Update last-alert state
    printf '%s\n%s\n' "$_system_alerts" "$_now_ts" > "$_last_alert_file"
  fi
fi

# ── Stale baseline cleanup ───────────────────────────────────
# Remove session baselines older than 24h (background, fire-and-forget)
find "$CONTEXT_DIR" -name '.session-baseline-*' -mtime +1 -delete 2>/dev/null &

# Belt-and-braces: never propagate a non-zero exit from a trailing background fork.
# A renderer that exits non-zero blanks the bar (per Claude Code statusline docs).
exit 0
